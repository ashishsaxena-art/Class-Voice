<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Create account"/>
<!doctype html><html lang="en"><head><%@ include file="/WEB-INF/includes/head.jsp" %></head>
<body class="cv-page"><%@ include file="/WEB-INF/includes/navbar.jsp" %>
<main class="cv-auth-section"><div class="container"><div class="row justify-content-center align-items-center g-5">
  <div class="col-lg-5 d-none d-lg-block cv-entrance"><div class="cv-auth-aside"><div class="cv-auth-mark mb-4"><i class="bi bi-stars"></i></div><h2>Learning works better when we <span style="color:#a8ffee">listen.</span></h2><p class="mt-3">Create your account to share honest questions, or help your students learn with clarity.</p><div class="cv-auth-check"><i class="bi bi-check-circle-fill"></i> Quick, easy classroom feedback</div><div class="cv-auth-check"><i class="bi bi-check-circle-fill"></i> Insights organized by topic</div><div class="cv-auth-check"><i class="bi bi-check-circle-fill"></i> A better way to learn together</div></div></div>
  <div class="col-md-9 col-lg-6 col-xl-5 cv-entrance cv-entrance-2"><div class="cv-auth-card"><div class="cv-auth-body p-md-5"><div class="cv-auth-icon"><i class="bi bi-person-plus"></i></div><span class="cv-overline">JOIN THE CLASSROOM</span><h1 class="mt-2 mb-2">Create your account.</h1><p class="cv-auth-subtitle mb-4">A few details and you're all set.</p>
  <c:if test="${not empty error}"><div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-2"></i><c:out value="${error}"/></div></c:if>
  <form method="post" action="${pageContext.request.contextPath}/register">
    <div class="mb-3"><label class="form-label" for="signupName">Full name</label><div class="input-group"><span class="input-group-text cv-input-icon"><i class="bi bi-person"></i></span><input id="signupName" class="form-control" name="name" value="<c:out value='${name}'/>" placeholder="Your full name" required maxlength="100" autocomplete="name"></div></div>
    <div class="mb-3"><label class="form-label" for="signupEmail">Email address</label><div class="input-group"><span class="input-group-text cv-input-icon"><i class="bi bi-envelope"></i></span><input id="signupEmail" class="form-control" type="email" name="email" value="<c:out value='${email}'/>" placeholder="you@example.com" required maxlength="190" autocomplete="email"></div></div>
    <div class="mb-3"><label class="form-label" for="signupPassword">Password</label><div class="input-group"><span class="input-group-text cv-input-icon"><i class="bi bi-lock"></i></span><input id="signupPassword" class="form-control" type="password" name="password" placeholder="At least 8 characters" required minlength="8" maxlength="100" autocomplete="new-password"><button type="button" class="input-group-text cv-password-toggle" data-password-toggle="signupPassword" aria-label="Show password" aria-pressed="false"><i class="bi bi-eye"></i></button></div></div>
    <div class="mb-4"><label class="form-label" for="signupRole">I am a</label><select id="signupRole" class="form-select" name="role" required><option value="student" ${role == 'student' ? 'selected' : ''}>Student</option><option value="teacher" ${role == 'teacher' ? 'selected' : ''}>Teacher</option></select></div>
    <button class="btn btn-primary w-100 py-3" type="submit">Create account <i class="bi bi-arrow-right ms-2"></i></button>
  </form><p class="small text-center text-secondary mt-4 mb-0">Already part of ClassVoice? <a class="fw-bold text-decoration-none" href="${pageContext.request.contextPath}/login.jsp">Sign in</a></p>
  </div></div></div>
</div></div></main><%@ include file="/WEB-INF/includes/footer.jsp" %></body></html>
