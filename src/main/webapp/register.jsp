<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Register"/>
<!doctype html><html lang="en"><head><%@ include file="/WEB-INF/includes/head.jsp" %></head><body><%@ include file="/WEB-INF/includes/navbar.jsp" %>
<main class="container py-5"><div class="row justify-content-center"><div class="col-md-7 col-lg-6"><div class="card cv-card shadow-sm"><div class="card-body p-4 p-md-5"><h1 class="h3 fw-bold">Create an account</h1><p class="text-secondary">Choose your role and start using ClassVoice.</p><c:if test="${not empty error}"><div class="alert alert-danger">${error}</div></c:if>
<form method="post" action="${pageContext.request.contextPath}/register"><div class="mb-3"><label class="form-label">Name</label><input class="form-control" name="name" value="${name}" required maxlength="100"></div><div class="mb-3"><label class="form-label">Email</label><input class="form-control" type="email" name="email" value="${email}" required maxlength="190"></div><div class="mb-3"><label class="form-label">Password</label><input class="form-control" type="password" name="password" required minlength="8" maxlength="100"></div><div class="mb-4"><label class="form-label">Role</label><select class="form-select" name="role" required><option value="student" ${role == 'student' ? 'selected' : ''}>Student</option><option value="teacher" ${role == 'teacher' ? 'selected' : ''}>Teacher</option></select></div><button class="btn btn-dark w-100">Create account</button></form></div></div></div></div></main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
