<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Give Feedback"/>
<!doctype html><html lang="en"><head><%@ include file="../includes/head.jsp" %></head><body><%@ include file="../includes/navbar.jsp" %><main class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><a class="small" href="${pageContext.request.contextPath}/student/dashboard">&larr; Back to lectures</a><div class="card cv-card mt-2"><div class="card-body p-4 p-md-5"><div class="d-flex justify-content-between gap-2"><h1 class="h4 fw-bold">${lecture.title}</h1><c:choose><c:when test="${lecture.active}"><span class="badge text-bg-success">Active</span></c:when><c:otherwise><span class="badge text-bg-secondary">Inactive</span></c:otherwise></c:choose></div><p class="text-secondary">${lecture.description}</p><hr><h2 class="h4 fw-bold">What did you not understand in today's lecture?</h2><p class="text-secondary small">Write one or two lines. The system maps your message to a relevant topic using predefined keywords.</p><c:if test="${not empty error}"><div class="alert alert-danger">${error}</div></c:if><form method="post" action="${pageContext.request.contextPath}/student/feedback"><input type="hidden" name="lectureId" value="${lecture.lectureId}"><textarea id="feedbackText" class="form-control" name="feedbackText" maxlength="1000" rows="6" placeholder="Example: I did not understand normalization and the difference between 2NF and 3NF." required>${feedbackTextValue}</textarea><div class="d-flex justify-content-between small text-secondary mt-1"><span id="charCounter">0/1000</span><span>Keep it focused.</span></div><div class="cv-anonymity my-3">Student identity is not displayed with the aggregated feedback.</div><button class="btn btn-dark w-100" ${lecture.active ? '' : 'disabled'}>Submit feedback</button></form></div></div></div></div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="${pageContext.request.contextPath}/js/app.js"></script></body></html>
