<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Feedback Analysis"/>
<!doctype html><html lang="en"><head><%@ include file="../includes/head.jsp" %></head><body class="cv-page"><%@ include file="../includes/navbar.jsp" %>
<main class="container cv-top-shell"><a class="cv-back-link" href="${pageContext.request.contextPath}/teacher/dashboard"><i class="bi bi-arrow-left"></i> Teacher dashboard</a>
<div class="cv-page-heading cv-entrance"><div class="d-flex justify-content-between flex-wrap align-items-start gap-3"><div><span class="cv-page-tag"><i class="bi bi-graph-up"></i> CLASS INSIGHTS</span><h1 class="mt-3 mb-1"><c:out value="${lecture.title}"/> — Analysis</h1><p class="text-secondary mb-0"><i class="bi bi-chat-left-text me-2"></i><c:out value="${feedbackList.size()}"/> valid feedback responses</p></div><a class="btn btn-outline-dark btn-sm" href="${pageContext.request.contextPath}/teacher/topics?lectureId=${lecture.lectureId}"><i class="bi bi-list-check me-2"></i> Manage topics</a></div></div>
<section class="card cv-card cv-table-card mb-4 cv-reveal"><div class="cv-card-header"><h2 class="cv-panel-title mb-1"><i class="bi bi-bar-chart-line cv-accent me-2"></i>Topic-wise confusion</h2><p class="small text-secondary mb-0">Topic feedback as a percentage of all valid feedback.</p></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th scope="col">Topic</th><th scope="col">Responses</th><th scope="col">Percentage</th><th scope="col" style="min-width:200px">Relative share</th></tr></thead><tbody><c:forEach var="s" items="${stats}"><tr><td><strong><c:out value="${s.topicName}"/></strong></td><td><c:out value="${s.count}"/></td><td><span class="cv-topic-pill"><fmt:formatNumber value="${s.percentage}" minFractionDigits="0" maxFractionDigits="1"/>%</span></td><td><div class="progress" role="progressbar" aria-label="Confusion for this topic" aria-valuenow="${s.percentage}" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:${s.percentage}%"></div></div></td></tr></c:forEach><c:if test="${empty stats}"><tr><td colspan="4" class="text-center text-secondary p-5">No topic statistics available yet.</td></tr></c:if></tbody></table></div></section>
<section class="card cv-card cv-reveal"><div class="cv-card-header"><h2 class="cv-panel-title mb-1"><i class="bi bi-chat-square-text cv-accent me-2"></i>Feedback responses</h2><p class="small text-secondary mb-0"><i class="bi bi-shield-check me-1"></i> Student names are not displayed with these responses.</p></div>
<div class="list-group list-group-flush"><c:forEach var="f" items="${feedbackList}"><article class="list-group-item p-4"><div class="d-flex justify-content-between flex-wrap gap-2 mb-3"><span class="cv-topic-pill"><c:out value="${empty f.topicName ? 'Other / Uncategorized' : f.topicName}"/></span><time class="small text-secondary"><c:out value="${f.submittedAt}"/></time></div><p class="cv-feedback-quote mb-0"><c:out value="${f.feedbackText}"/></p></article></c:forEach><c:if test="${empty feedbackList}"><div class="cv-empty"><div class="cv-empty-icon"><i class="bi bi-chat-left-text"></i></div><h3 class="h5 fw-bold">Nothing here yet.</h3><p class="text-secondary mb-0">Responses will appear after students submit feedback.</p></div></c:if></div></section>
</main><%@ include file="../includes/footer.jsp" %></body></html>
