<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><c:set var="pageTitle" value="Feedback Analysis"/>
<!doctype html><html lang="en"><head><%@ include file="../includes/head.jsp" %></head><body><%@ include file="../includes/navbar.jsp" %><main class="container py-4"><a href="${pageContext.request.contextPath}/teacher/dashboard" class="small">&larr; Dashboard</a><div class="d-flex justify-content-between align-items-start flex-wrap mt-2 mb-4"><div><h1 class="h3 fw-bold mb-1">${lecture.title} — Analysis</h1><p class="text-secondary mb-0">Total valid feedback: ${feedbackList.size()}</p></div><a class="btn btn-outline-dark btn-sm" href="${pageContext.request.contextPath}/teacher/topics?lectureId=${lecture.lectureId}">Manage topics</a></div>
<div class="card cv-card mb-4"><div class="card-body p-0"><div class="p-4 border-bottom"><h2 class="h5 fw-bold mb-1">Topic-wise confusion</h2><p class="small text-secondary mb-0">Percentage = topic feedback ÷ total valid feedback × 100.</p></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Topic</th><th>Confusion count</th><th>Percentage</th><th style="min-width:220px">Share</th></tr></thead><tbody><c:forEach var="s" items="${stats}"><tr><td class="fw-semibold">${s.topicName}</td><td>${s.count} response<c:if test="${s.count != 1}">s</c:if></td><td><fmt:formatNumber value="${s.percentage}" minFractionDigits="0" maxFractionDigits="1"/>%</td><td><div class="progress"><div class="progress-bar" style="width:${s.percentage}%"></div></div></td></tr></c:forEach><c:if test="${empty stats}"><tr><td colspan="4" class="text-center text-secondary p-4">No feedback has been submitted yet.</td></tr></c:if></tbody></table></div></div></div>
<div class="card cv-card"><div class="card-body p-0"><div class="p-4 border-bottom"><h2 class="h5 fw-bold mb-1">Anonymous feedback responses</h2><p class="small text-secondary mb-0">Student identity is not displayed here.</p></div><div class="list-group list-group-flush"><c:forEach var="f" items="${feedbackList}"><div class="list-group-item p-4"><div class="d-flex justify-content-between gap-3 mb-2"><span class="badge text-bg-light border">${empty f.topicName ? 'Other / Uncategorized' : f.topicName}</span><span class="small text-secondary">${f.submittedAt}</span></div><p class="mb-0">${f.feedbackText}</p></div></c:forEach><c:if test="${empty feedbackList}"><div class="p-5 text-center text-secondary">No responses yet.</div></c:if></div></div></div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
