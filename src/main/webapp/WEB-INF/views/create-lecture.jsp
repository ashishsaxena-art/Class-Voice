<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Create Lecture"/>
<!doctype html><html lang="en"><head><%@ include file="../includes/head.jsp" %></head><body><%@ include file="../includes/navbar.jsp" %><main class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><a href="${pageContext.request.contextPath}/teacher/dashboard" class="small">&larr; Dashboard</a><div class="card cv-card mt-2"><div class="card-body p-4 p-md-5"><h1 class="h3 fw-bold">Create lecture</h1><p class="text-secondary">After creating it, add topics and keywords before activating it.</p><c:if test="${not empty error}"><div class="alert alert-danger">${error}</div></c:if><form method="post" action="${pageContext.request.contextPath}/teacher/lecture/create"><div class="mb-3"><label class="form-label">Lecture title</label><input class="form-control" name="title" maxlength="180" required></div><div class="mb-3"><label class="form-label">Date</label><input class="form-control" type="date" name="lectureDate" value="${empty param.lectureDate ? '' : param.lectureDate}" required></div><div class="mb-4"><label class="form-label">Description</label><textarea class="form-control" name="description" maxlength="500" rows="3"></textarea></div><button class="btn btn-dark">Create and add topics</button></form></div></div></div></div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
