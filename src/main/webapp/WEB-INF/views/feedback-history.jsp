<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Feedback History"/>
<!doctype html><html lang="en"><head><%@ include file="../includes/head.jsp" %></head><body class="cv-page"><%@ include file="../includes/navbar.jsp" %>
<main class="container cv-top-shell"><a class="cv-back-link" href="${pageContext.request.contextPath}/student/dashboard"><i class="bi bi-arrow-left"></i> Active lectures</a><div class="cv-page-heading cv-entrance"><span class="cv-page-tag"><i class="bi bi-clock-history"></i> YOUR JOURNEY</span><h1 class="mt-3 mb-1">My feedback history</h1><p class="text-secondary"><i class="bi bi-lock me-1"></i> Only you can see this personal feedback history.</p></div>
<div class="card cv-card cv-table-card cv-reveal"><div class="card-body p-0"><div class="table-responsive"><table class="table align-middle"><thead><tr><th scope="col">Lecture</th><th scope="col">Mapped topic</th><th scope="col">Feedback</th><th scope="col">Submitted</th></tr></thead><tbody>
<c:forEach var="f" items="${history}"><tr><td><strong><c:out value="${f.lectureTitle}"/></strong></td><td><span class="cv-topic-pill"><c:out value="${empty f.topicName ? 'Other / Uncategorized' : f.topicName}"/></span></td><td><c:out value="${f.feedbackText}"/></td><td><c:out value="${f.submittedAt}"/></td></tr></c:forEach>
<c:if test="${empty history}"><tr><td colspan="4"><div class="cv-empty"><div class="cv-empty-icon"><i class="bi bi-chat-square-heart"></i></div><h3 class="h5 fw-bold">Your story starts with a question.</h3><p class="text-secondary">You haven't submitted feedback yet.</p><a class="btn btn-primary" href="${pageContext.request.contextPath}/student/dashboard">Find a lecture</a></div></td></tr></c:if></tbody></table></div></div></div>
</main><%@ include file="../includes/footer.jsp" %></body></html>
