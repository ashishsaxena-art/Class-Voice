<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="My Feedback History"/>
<!doctype html><html lang="en"><head><%@ include file="../includes/head.jsp" %></head><body><%@ include file="../includes/navbar.jsp" %><main class="container py-4"><a href="${pageContext.request.contextPath}/student/dashboard" class="small">&larr; Active lectures</a><h1 class="h3 fw-bold mt-2">My Feedback History</h1><p class="text-secondary">Only you can see this personal history page.</p><div class="card cv-card"><div class="card-body p-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Lecture</th><th>Mapped topic</th><th>Feedback</th><th>Submitted</th></tr></thead><tbody><c:forEach var="f" items="${history}"><tr><td>${f.lectureTitle}</td><td>${empty f.topicName ? 'Other / Uncategorized' : f.topicName}</td><td>${f.feedbackText}</td><td>${f.submittedAt}</td></tr></c:forEach><c:if test="${empty history}"><tr><td colspan="4" class="p-5 text-center text-secondary">You have not submitted feedback yet.</td></tr></c:if></tbody></table></div></div></div></main></body></html>
