<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Student Dashboard"/>
<!doctype html><html lang="en"><head><%@ include file="../includes/head.jsp" %></head><body><%@ include file="../includes/navbar.jsp" %><main class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 fw-bold mb-1">Active Lectures</h1><p class="text-secondary mb-0">Hi ${sessionScope.user.name} — these lectures are accepting feedback.</p></div><a class="btn btn-outline-dark btn-sm" href="${pageContext.request.contextPath}/student/history">My History</a></div><c:if test="${param.error == 'wrong-role'}"><div class="alert alert-warning">That page belongs to teachers.</div></c:if><div class="cv-anonymity mb-4">Student identity is not displayed with the aggregated feedback.</div><c:if test="${empty activeLectures}"><div class="card cv-card p-5 text-center text-secondary">There is no active lecture right now.</div></c:if><div class="row g-4"><c:forEach var="l" items="${activeLectures}"><div class="col-md-6 col-lg-4"><div class="card cv-card h-100"><div class="card-body p-4 d-flex flex-column"><div class="d-flex justify-content-between gap-2"><h2 class="h5 fw-bold">${l.title}</h2><span class="badge text-bg-success">Active</span></div><div class="small text-secondary">by ${l.teacherName} · ${l.lectureDate}</div><p class="small text-secondary mt-3 flex-grow-1">${l.description}</p><a class="btn btn-dark" href="${pageContext.request.contextPath}/student/feedback?lectureId=${l.lectureId}">Give Feedback</a></div></div></div></c:forEach></div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
