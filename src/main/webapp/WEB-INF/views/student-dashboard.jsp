<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="pageTitle" value="Student Dashboard"/>
<!doctype html><html lang="en"><head><%@ include file="../includes/head.jsp" %></head>
<body class="cv-page"><%@ include file="../includes/navbar.jsp" %>
<main class="container cv-top-shell">
  <div class="cv-dashboard-welcome cv-entrance"><div class="row g-4 align-items-center"><div class="col-md-8"><span class="cv-dash-tag"><i class="bi bi-backpack me-2"></i> STUDENT WORKSPACE</span><h1 class="mt-2">Hey, <c:out value="${sessionScope.user.name}"/> <span aria-hidden="true">👋</span></h1><p class="mt-2">Every question is a step forward. Find a lecture and let your voice be heard.</p></div><div class="col-md-4 text-md-end"><a class="btn btn-light" href="${pageContext.request.contextPath}/student/history"><i class="bi bi-clock-history me-2"></i> My history</a></div></div></div>
  <c:if test="${param.error == 'wrong-role'}"><div class="alert alert-warning" role="alert"><i class="bi bi-info-circle me-2"></i>That page belongs to teachers.</div></c:if>
  <div class="cv-sync-row mb-3 cv-reveal cv-slide-left" data-live-dashboard data-live-role="student" data-endpoint="${pageContext.request.contextPath}/api/dashboard-pulse">
    <span class="cv-sync-state" data-live-state role="status" aria-live="polite"><i class="bi bi-database-check"></i> Checking available lectures…</span>
    <button type="button" class="cv-sync-button" data-live-refresh><i class="bi bi-arrow-clockwise"></i> Sync stats</button><a class="cv-sync-page" href="${pageContext.request.contextPath}/student/dashboard"><i class="bi bi-arrow-repeat"></i> Reload lectures</a>
  </div>
  <div class="cv-anonymity mb-4 cv-reveal"><i class="bi bi-shield-check"></i> Your identity is not displayed beside your feedback in teacher analysis.</div>
  <div class="cv-section-row cv-reveal cv-slide-left"><div><h2>Available lectures <span class="cv-lecture-count" data-live-value="activeLectures"><c:out value="${fn:length(activeLectures)}"/></span></h2><p class="small text-secondary mt-2 mb-0">Choose a session to share what's unclear.</p></div><span class="cv-status cv-status-live"><i class="bi bi-circle-fill" style="font-size:.48rem"></i> Open for feedback</span></div>
  <c:choose><c:when test="${empty activeLectures}"><div class="card cv-card cv-reveal cv-slide-right"><div class="cv-empty"><div class="cv-empty-icon"><i class="bi bi-calendar2-week"></i></div><h3 class="h5 fw-bold">No active lectures right now.</h3><p class="text-secondary">When your teacher starts a lecture, it'll show up here.</p></div></div></c:when>
  <c:otherwise><div class="row g-4 cv-reveal cv-slide-right"><c:forEach var="l" items="${activeLectures}"><div class="col-md-6 col-lg-4"><article class="card cv-card cv-card-lift cv-lecture-card"><div class="card-body"><div class="d-flex justify-content-between align-items-start gap-2"><span class="cv-lecture-icon"><i class="bi bi-journal-text"></i></span><span class="cv-status cv-status-live"><i class="bi bi-circle-fill" style="font-size:.48rem"></i> Active</span></div><h3 class="cv-lecture-title"><c:out value="${l.title}"/></h3><p class="cv-lecture-meta"><i class="bi bi-person me-1"></i> <c:out value="${l.teacherName}"/><span class="mx-1">·</span><i class="bi bi-calendar3 me-1"></i><c:out value="${l.lectureDate}"/></p><p class="cv-lecture-desc mt-2"><c:out value="${l.description}"/></p><a class="btn btn-primary mt-3 w-100" href="${pageContext.request.contextPath}/student/feedback?lectureId=${l.lectureId}">Give feedback <i class="bi bi-arrow-right ms-2"></i></a></div></article></div></c:forEach></div></c:otherwise></c:choose>
</main><%@ include file="../includes/footer.jsp" %></body></html>
