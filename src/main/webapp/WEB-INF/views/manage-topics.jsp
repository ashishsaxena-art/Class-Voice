<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Manage Topics"/>
<!doctype html><html lang="en"><head><%@ include file="../includes/head.jsp" %></head><body><%@ include file="../includes/navbar.jsp" %><main class="container py-4"><a href="${pageContext.request.contextPath}/teacher/dashboard" class="small">&larr; Dashboard</a><div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-2 mb-4"><div><h1 class="h3 fw-bold mb-1">${lecture.title}</h1><p class="text-secondary mb-0">Add topics and comma-separated keywords. Activate when ready.</p></div><div><c:choose><c:when test="${lecture.active}"><span class="badge text-bg-success fs-6">Active</span><form class="d-inline" method="post" action="${pageContext.request.contextPath}/teacher/lecture/end"><input type="hidden" name="lectureId" value="${lecture.lectureId}"><button class="btn btn-outline-danger btn-sm ms-2">End lecture</button></form></c:when><c:otherwise><form method="post" action="${pageContext.request.contextPath}/teacher/lecture/activate"><input type="hidden" name="lectureId" value="${lecture.lectureId}"><button class="btn btn-dark">Activate lecture</button></form></c:otherwise></c:choose></div></div>
<c:if test="${not empty sessionScope.flash}"><div class="alert alert-success">${sessionScope.flash}</div><c:remove var="flash" scope="session"/></c:if><c:if test="${not empty sessionScope.flashError}"><div class="alert alert-danger">${sessionScope.flashError}</div><c:remove var="flashError" scope="session"/></c:if>
<div class="row g-4"><div class="col-lg-7"><div class="card cv-card"><div class="card-body p-4"><h2 class="h5 fw-bold">Topics</h2><c:if test="${empty topics}"><p class="text-secondary">No topics yet.</p></c:if><c:forEach var="t" items="${topics}"><div class="border rounded-3 p-3 mb-3"><div class="d-flex justify-content-between gap-3"><div><h3 class="h6 fw-bold mb-1">${t.topicName}</h3><p class="small text-secondary mb-2">${t.description}</p></div><span class="small text-secondary">${t.keywords.size()} keywords</span></div><div class="mb-2"><c:forEach var="k" items="${t.keywords}"><span class="badge text-bg-light border me-1 mb-1">${k.keyword}</span></c:forEach><c:if test="${empty t.keywords}"><span class="small text-secondary">No keywords yet.</span></c:if></div><form class="d-flex gap-2" method="post" action="${pageContext.request.contextPath}/teacher/keyword/add"><input type="hidden" name="lectureId" value="${lecture.lectureId}"><input type="hidden" name="topicId" value="${t.topicId}"><input class="form-control form-control-sm" name="keywords" maxlength="300" placeholder="normalization, 2NF, 3NF"><button class="btn btn-sm btn-outline-dark">Add</button></form></div></c:forEach></div></div></div>
<div class="col-lg-5"><div class="card cv-card"><div class="card-body p-4"><h2 class="h5 fw-bold">Add topic</h2><form method="post" action="${pageContext.request.contextPath}/teacher/topic/add"><input type="hidden" name="lectureId" value="${lecture.lectureId}"><div class="mb-3"><label class="form-label">Topic name</label><input class="form-control" name="topicName" maxlength="150" required></div><div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="topicDescription" maxlength="300" rows="3"></textarea></div><button class="btn btn-dark w-100">Add topic</button></form><hr><p class="small text-secondary mb-0">Tip: use distinctive words or phrases. The matching algorithm counts each keyword at most once per feedback response.</p></div></div></div></div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
