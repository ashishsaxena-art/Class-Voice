<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Manage Topics"/>
<!doctype html><html lang="en"><head><%@ include file="../includes/head.jsp" %></head><body class="cv-page"><%@ include file="../includes/navbar.jsp" %>
<main class="container cv-top-shell"><a class="cv-back-link" href="${pageContext.request.contextPath}/teacher/dashboard"><i class="bi bi-arrow-left"></i> Dashboard</a>
<div class="cv-page-heading cv-entrance"><div class="d-flex flex-wrap gap-3 justify-content-between align-items-start"><div><span class="cv-page-tag"><i class="bi bi-list-check"></i> TOPIC MANAGER</span><h1 class="mt-3 mb-1"><c:out value="${lecture.title}"/></h1><p class="text-secondary mb-0">Add topics and keywords, then activate the lecture when you're ready.</p></div>
<div class="d-flex align-items-center gap-2"><c:choose><c:when test="${lecture.active}"><span class="cv-status cv-status-live"><i class="bi bi-circle-fill" style="font-size:.48rem"></i> Active</span><form method="post" action="${pageContext.request.contextPath}/teacher/lecture/end"><input type="hidden" name="lectureId" value="${lecture.lectureId}"><button type="submit" class="btn btn-outline-danger btn-sm">End lecture</button></form></c:when><c:otherwise><form method="post" action="${pageContext.request.contextPath}/teacher/lecture/activate"><input type="hidden" name="lectureId" value="${lecture.lectureId}"><button type="submit" class="btn btn-primary"><i class="bi bi-play-circle me-1"></i> Activate lecture</button></form></c:otherwise></c:choose></div></div></div>
<c:if test="${not empty sessionScope.flash}"><div class="alert alert-success"><c:out value="${sessionScope.flash}"/></div><c:remove var="flash" scope="session"/></c:if>
<c:if test="${not empty sessionScope.flashError}"><div class="alert alert-danger"><c:out value="${sessionScope.flashError}"/></div><c:remove var="flashError" scope="session"/></c:if>
<div class="row g-4"><div class="col-lg-7 cv-reveal"><div class="card cv-card h-100"><div class="card-body p-4"><h2 class="cv-panel-title mb-4"><i class="bi bi-collection cv-accent me-2"></i>Lecture topics</h2>
<c:if test="${empty topics}"><div class="cv-empty"><div class="cv-empty-icon"><i class="bi bi-collection"></i></div><h3 class="h5 fw-bold">No topics added yet</h3><p class="text-secondary mb-0">Use the form to add your first topic.</p></div></c:if>
<c:forEach var="t" items="${topics}"><div class="cv-topic-item"><div class="d-flex justify-content-between flex-wrap gap-2"><div><h3 class="mb-1"><c:out value="${t.topicName}"/></h3><p class="small text-secondary mb-2"><c:out value="${t.description}"/></p></div><span class="cv-panel-label"><c:out value="${t.keywords.size()}"/> keywords</span></div><div class="mb-3"><c:forEach var="k" items="${t.keywords}"><span class="badge bg-light text-dark border me-1 mb-1"><c:out value="${k.keyword}"/></span></c:forEach><c:if test="${empty t.keywords}"><span class="small text-secondary">No keywords yet.</span></c:if></div>
<form class="d-flex flex-column flex-sm-row gap-2" method="post" action="${pageContext.request.contextPath}/teacher/keyword/add"><input type="hidden" name="lectureId" value="${lecture.lectureId}"><input type="hidden" name="topicId" value="${t.topicId}"><input class="form-control form-control-sm" name="keywords" maxlength="300" placeholder="e.g. normalization, 2NF, 3NF" aria-label="Add keywords"><button class="btn btn-sm btn-outline-dark" type="submit"><i class="bi bi-plus-lg"></i> Add</button></form></div></c:forEach>
</div></div></div>
<div class="col-lg-5 cv-reveal"><div class="card cv-card"><div class="card-body p-4"><h2 class="cv-panel-title mb-2"><i class="bi bi-plus-circle cv-accent me-2"></i>Add a topic</h2><p class="text-secondary small mb-4">Choose a topic name and a short description.</p>
<form method="post" action="${pageContext.request.contextPath}/teacher/topic/add"><input type="hidden" name="lectureId" value="${lecture.lectureId}"><div class="mb-3"><label class="form-label" for="topicName">Topic name</label><input id="topicName" class="form-control" name="topicName" maxlength="150" placeholder="e.g. Normalization" required></div><div class="mb-4"><label class="form-label" for="topicDescription">Description</label><textarea id="topicDescription" class="form-control" name="topicDescription" maxlength="300" rows="3" placeholder="A quick summary of this topic"></textarea></div><button class="btn btn-primary w-100" type="submit">Add topic <i class="bi bi-plus-lg ms-1"></i></button></form><div class="cv-auth-note mt-4"><i class="bi bi-lightbulb me-2 cv-accent"></i>Tip: Use distinctive words. Each keyword is counted at most once per feedback response.</div>
</div></div></div></div>
</main><%@ include file="../includes/footer.jsp" %></body></html>
