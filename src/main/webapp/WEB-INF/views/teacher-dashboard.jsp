<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Teacher Dashboard"/>
<!doctype html><html lang="en"><head><%@ include file="../includes/head.jsp" %></head><body><%@ include file="../includes/navbar.jsp" %><main class="container py-4">
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4"><div><h1 class="h3 fw-bold mb-1">Teacher Dashboard</h1><p class="text-secondary mb-0">Create lectures, collect feedback, and inspect topic-wise results.</p></div><a class="btn btn-dark" href="${pageContext.request.contextPath}/teacher/create">+ Create lecture</a></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card cv-card"><div class="card-body"><div class="text-secondary small">Active lectures</div><div class="display-6 fw-bold">${activeCount}</div></div></div></div><div class="col-md-4"><div class="card cv-card"><div class="card-body"><div class="text-secondary small">Total feedback</div><div class="display-6 fw-bold">${feedbackCount}</div></div></div></div><div class="col-md-4"><div class="card cv-card"><div class="card-body"><div class="text-secondary small">Topic attention</div><div class="display-6 fw-bold">Review</div></div></div></div></div>
<div class="card cv-card"><div class="card-body p-0"><div class="p-4 border-bottom d-flex justify-content-between"><h2 class="h5 fw-bold mb-0">Your lectures</h2><a href="${pageContext.request.contextPath}/teacher/create" class="btn btn-sm btn-dark">Create lecture</a></div><c:if test="${empty lectures}"><div class="p-5 text-center text-secondary">No lectures yet. Create your first lecture.</div></c:if><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Lecture</th><th>Date</th><th>Status</th><th>Topics</th><th>Feedback</th><th></th></tr></thead><tbody><c:forEach var="l" items="${lectures}"><tr><td><strong>${l.title}</strong><div class="small text-secondary">${l.description}</div></td><td>${l.lectureDate}</td><td><c:choose><c:when test="${l.active}"><span class="badge text-bg-success">Active</span></c:when><c:otherwise><span class="badge text-bg-secondary">Inactive</span></c:otherwise></c:choose></td><td>${l.topicCount}</td><td>${l.feedbackCount}</td><td class="text-end"><div class="btn-group btn-group-sm"><a class="btn btn-outline-dark" href="${pageContext.request.contextPath}/teacher/topics?lectureId=${l.lectureId}">Topics</a><a class="btn btn-outline-dark" href="${pageContext.request.contextPath}/teacher/analysis?lectureId=${l.lectureId}">Analysis</a><c:if test="${l.active}"><form method="post" action="${pageContext.request.contextPath}/teacher/lecture/end"><input type="hidden" name="lectureId" value="${l.lectureId}"><button class="btn btn-outline-danger">End</button></form></c:if></div></td></tr></c:forEach></tbody></table></div></div></div>
</main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
