<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Teacher Dashboard"/>
<!doctype html><html lang="en"><head><%@ include file="../includes/head.jsp" %></head>
<body class="cv-page"><%@ include file="../includes/navbar.jsp" %>
<main class="container cv-top-shell">
  <div class="cv-dashboard-welcome cv-entrance"><div class="row align-items-center g-4"><div class="col-md-8"><span class="cv-dash-tag"><i class="bi bi-mortarboard me-2"></i> TEACHER WORKSPACE</span><h1 class="mt-2">Hello, <c:out value="${sessionScope.user.name}"/> <span aria-hidden="true">👋</span></h1><p class="mt-2">A clearer view of how your class is doing. Keep learning moving forward.</p></div><div class="col-md-4 text-md-end"><a class="btn btn-light" href="${pageContext.request.contextPath}/teacher/create"><i class="bi bi-plus-circle me-2"></i> Create a lecture</a></div></div></div>
  <div class="row g-3 mb-5 cv-reveal cv-slide-right">
    <div class="col-sm-6 col-lg-4"><div class="cv-stat-card"><span class="cv-icon-soft violet"><i class="bi bi-broadcast"></i></span><div class="cv-stat-value" data-count="${activeCount}"><c:out value="${activeCount}"/></div><div class="cv-stat-label">Active lectures</div></div></div>
    <div class="col-sm-6 col-lg-4"><div class="cv-stat-card"><span class="cv-icon-soft mint"><i class="bi bi-chat-left-text"></i></span><div class="cv-stat-value" data-count="${feedbackCount}"><c:out value="${feedbackCount}"/></div><div class="cv-stat-label">Feedback responses</div></div></div>
    <div class="col-sm-6 col-lg-4"><div class="cv-stat-card"><span class="cv-icon-soft peach"><i class="bi bi-lightbulb"></i></span><div class="cv-stat-value"><i class="bi bi-graph-up-arrow fs-3 cv-accent" aria-label="Insights available"></i></div><div class="cv-stat-label">Topic insights ready to explore</div></div></div>
  </div>
  <div class="cv-section-row cv-reveal cv-slide-left"><div><h2>Your lectures</h2><p class="text-secondary small mb-0 mt-2">Manage topics, review insights, and keep your class engaged.</p></div><a href="${pageContext.request.contextPath}/teacher/create" class="btn btn-outline-dark btn-sm"><i class="bi bi-plus-lg me-1"></i> New lecture</a></div>
  <div class="card cv-card cv-table-card cv-reveal cv-slide-right"><div class="card-body p-0">
    <c:choose><c:when test="${empty lectures}"><div class="cv-empty"><div class="cv-empty-icon"><i class="bi bi-journal-plus"></i></div><h3 class="h5 fw-bold">Your first lecture starts here.</h3><p class="text-secondary">Create a lecture, add topics, and start collecting responses.</p><a href="${pageContext.request.contextPath}/teacher/create" class="btn btn-primary mt-2">Create lecture <i class="bi bi-arrow-right ms-1"></i></a></div></c:when>
    <c:otherwise><div class="table-responsive"><table class="table align-middle"><thead><tr><th scope="col">Lecture</th><th scope="col">Date</th><th scope="col">Status</th><th scope="col">Topics</th><th scope="col">Feedback</th><th scope="col" class="text-end">Actions</th></tr></thead><tbody>
      <c:forEach var="l" items="${lectures}"><tr><td><strong><c:out value="${l.title}"/></strong><div class="small text-secondary mt-1"><c:out value="${l.description}"/></div></td><td><c:out value="${l.lectureDate}"/></td>
        <td><c:choose><c:when test="${l.active}"><span class="cv-status cv-status-live"><i class="bi bi-circle-fill" style="font-size:.48rem"></i> Active</span></c:when><c:otherwise><span class="cv-status cv-status-idle">Ended</span></c:otherwise></c:choose></td><td><c:out value="${l.topicCount}"/></td><td><c:out value="${l.feedbackCount}"/></td><td class="text-end"><div class="d-flex flex-wrap gap-2 justify-content-end"><a class="btn btn-sm btn-outline-dark" href="${pageContext.request.contextPath}/teacher/topics?lectureId=${l.lectureId}"><i class="bi bi-list-check me-1"></i> Topics</a><a class="btn btn-sm btn-outline-dark" href="${pageContext.request.contextPath}/teacher/analysis?lectureId=${l.lectureId}"><i class="bi bi-bar-chart me-1"></i> Analysis</a><c:if test="${l.active}"><form method="post" action="${pageContext.request.contextPath}/teacher/lecture/end"><input type="hidden" name="lectureId" value="${l.lectureId}"><button class="btn btn-sm btn-outline-danger" type="submit">End</button></form></c:if></div></td></tr></c:forEach>
    </tbody></table></div></c:otherwise></c:choose>
  </div></div>
</main><%@ include file="../includes/footer.jsp" %></body></html>
